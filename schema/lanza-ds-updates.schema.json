{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/t2Engineer/2t-engineer-updates/blob/main/schema/lanza-ds-updates.schema.json",
  "title": "2T Инженер update catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_name", "release_notes", "updates"],
  "properties": {
    "schema_version": { "const": 1 },
    "release_name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "release_notes": { "type": "string", "maxLength": 1200 },
    "updates": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/deviceUpdate" }
    },
    "app_update": { "$ref": "#/$defs/appUpdate" }
  },
  "anyOf": [
    { "properties": { "updates": { "minItems": 1 } } },
    { "required": ["app_update"] }
  ],
  "$defs": {
    "common": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "target", "file_name", "url", "sha256", "size", "notes"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": { "type": "string", "minLength": 1, "maxLength": 48 },
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^/\\\\]+$"
        },
        "url": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^https://(github\\.com|api\\.github\\.com|raw\\.githubusercontent\\.com|objects\\.githubusercontent\\.com|release-assets\\.githubusercontent\\.com)/"
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        },
        "size": { "type": "integer", "minimum": 1024 },
        "notes": { "type": "string", "maxLength": 600 }
      }
    },
    "deviceUpdate": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["ota", "core"] },
            "size": { "maximum": 4194304 }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "ota" } } },
              "then": {
                "properties": {
                  "target": { "enum": ["16MB", "START-4MB", "ANY"] },
                  "file_name": { "pattern": "\\.bin$" }
                }
              }
            },
            {
              "if": { "properties": { "kind": { "const": "core" } } },
              "then": {
                "properties": {
                  "target": { "enum": ["MOTO2", "MOTO1", "LEGACY4", "MIGRATION", "ANY"] },
                  "file_name": { "pattern": "\\.(bin|crp)$" }
                }
              }
            }
          ]
        }
      ]
    },
    "appUpdate": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "properties": {
            "target": { "enum": ["ANDROID", "ANY"] },
            "file_name": { "pattern": "\\.apk$" },
            "size": { "maximum": 100663296 }
          }
        }
      ]
    }
  }
}
